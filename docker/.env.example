# Copy to `.env` (in this docker/ directory) and fill in. `docker compose` reads
# `.env` here automatically. NEVER commit the real `.env` (it is gitignored).

# Per-user isolation on this shared host. PPS_USER namespaces the compose project,
# containers, image, and volumes. DESKTOP_PORT must be unique per user.
PPS_USER=
DESKTOP_PORT=6084

# The host's default Docker address pools are exhausted; pin a free subnet.
# Change if 10.203.0.0/24 ever clashes with another project.
PPSNET_SUBNET=10.203.0.0/24

# Which GPUs the container sees. Default is all; set e.g. "0" or "0,1" to limit.
# NVIDIA_VISIBLE_DEVICES=all
